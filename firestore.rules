rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles - strict owner read/write
    match /users/{userId}/profile {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.role is string;
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isValidId(orgId)
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 128;
      allow update: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid || request.auth.token.email_verified == true);
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;

      // Subcollections within an organization
      match /tasks/{taskId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && isValidId(taskId)
          && request.resource.data.orgId == orgId;
        allow delete: if isSignedIn();
      }

      match /approvals/{approvalId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && isValidId(approvalId)
          && request.resource.data.orgId == orgId;
        allow delete: if isSignedIn();
      }

      match /customers/{customerId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && isValidId(customerId)
          && request.resource.data.orgId == orgId;
        allow delete: if isSignedIn();
      }

      match /workflows/{workflowId} {
        allow read: if isSignedIn();
        allow create, update: if isSignedIn()
          && isValidId(workflowId)
          && request.resource.data.orgId == orgId;
        allow delete: if isSignedIn();
      }
    }
  }
}

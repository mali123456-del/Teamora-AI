# TEAMORA AI — Environment Variables Template
# Never commit real secret values to source control.
# Configure runtime secrets via the hosting Secret Manager or local .env (ignored by git).

# Runtime environment profile: development | staging | production
APP_ENV="development"
NODE_ENV="development"

# HTTP Server Port (AI Studio & preview runtime require port 3000)
PORT="3000"

# GEMINI_API_KEY: Server-side only Gemini AI API key (NEVER prefix with VITE_)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical deployment origin for callbacks and CORS verification
APP_URL="MY_APP_URL"

# ALLOWED_ORIGINS: Comma-separated origins allowed in staging/production CORS enforcement
ALLOWED_ORIGINS="http://localhost:3000"

# Logging verbosity: debug | info | warn | error
LOG_LEVEL="info"

# Backup snapshot retention policy (days)
BACKUP_RETENTION_DAYS="30"

# Billing safety guard: sandbox | live (keep sandbox until merchant verification & explicit approval)
BILLING_MODE="sandbox"

# Webhook HMAC signing secret for billing & integration verification (configure via Secrets Manager)
SAAS_WEBHOOK_SECRET="configure_via_secrets_manager"

# Optional isolated staging Firebase project ID (prevents staging traffic hitting production Firestore)
# STAGING_FIREBASE_PROJECT_ID="teamora-ai-staging"
